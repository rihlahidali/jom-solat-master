{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "domain/**/*.ts",
    "tests/domain/**/*.ts",
    "tests/functional/**/*.ts",
    "tests/bootstrap.ts",
    "bin/test.ts",
    "bin/seed_timetable.ts"
  ]
}
